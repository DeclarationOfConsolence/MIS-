# ============================================================
# NapChief MIS Dashboard — environment variables
# Copy this file to ".env.local" and fill in the values.
# .env.local is gitignored and NEVER goes to GitHub/Vercel git.
# ============================================================

# Your Asana Personal Access Token.
# Get it from: Asana -> Profile -> Settings -> Apps -> Developer apps
# -> Personal access tokens -> Create new token
ASANA_TOKEN=paste-your-asana-token-here

# OPTIONAL: pin a specific Asana workspace by its GID.
# Leave blank to auto-use your first workspace.
ASANA_WORKSPACE_GID=

# OPTIONAL sync-safety knobs (sensible defaults if unset):
# How many Asana projects to fetch in parallel. Default 16. Lower (e.g. 8) to
# reduce 429 rate-limit pressure on large/recovery syncs.
ASANA_CONCURRENCY=
# Hard safety valve: abort the prune if one run would delete more than this
# fraction of the DB (default 0.02 = 2%) or this many rows (default 300),
# whichever is larger. Protects against mass false deletions.
SYNC_MAX_PRUNE_PCT=
SYNC_MAX_PRUNE_ABS=
# To allow a genuine large cleanup for ONE run instead of raising the limits,
# set the Supabase mis_meta row key 'approve_bulk_prune' to 'true' (the sync
# consumes it and resets it to 'false').

# Secret used to sign login sessions. Use any long random string.
SESSION_SECRET=change-this-to-a-long-random-string-napchief-mis-2026

# Supabase — stores the user accounts.
# From Supabase -> Project -> Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Fallback accounts, used ONLY when Supabase is not configured.
# Format: user:pass,user:pass  (sumanth = admin in fallback mode)
MIS_ACCOUNTS=sumanth:nap123,user2:nap123,user3:nap123,user4:nap123,user5:nap123

# Optional: enables the in-app "Sync now" button to trigger GitHub Actions.
GITHUB_REPO=your-username/MSI-Tracker
GITHUB_DISPATCH_TOKEN=github-token-with-repo-scope
